# Copy to .env next to compose.yaml and adjust. Values below are the defaults.
IMAGE_TAG=latest
HTTPS_PORT=3443                 # the port Visitors open: https://<server>:3443

# Workers per language = how many Visitors can speak that language at the same moment.
# Each worker holds its own copy of the model (RAM per worker: see README, Benchmark).
STT_WORKERS_TH=3
STT_WORKERS_EN=2
STT_MEM_TH=5g                   # container RAM caps (~1.4 GiB per Thai worker, ~0.5 per English on CPU); raise with the worker counts
STT_MEM_EN=2g

# Model variants (must be baked into the image: docker build --build-arg STT_MODELS="<th> <en>")
STT_MODEL_TH=biodatlab/whisper-th-small-combined
STT_MODEL_EN=openai/whisper-base.en
STT_QUANTIZE=                   # int8 = smaller/faster on some x86 CPUs; measure first (ADR 0009)

SLOT_TTL_MS=30000               # an unused reservation is given back after this (15 s recording + transcription)
